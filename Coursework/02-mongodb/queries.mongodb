use('coursework')

db.books.insertOne({ title: 'Shell inserted', year: 2024, genres: ['test'], rating: 3 })

db.books.find({ year: { $gte: 1950 } }).sort({ year: 1 })

db.books.find({ genres: { $in: ['fantasy', 'satire'] } }, { title: 1, _id: 0 })

db.books.updateMany({ rating: { $lt: 4 } }, { $inc: { rating: 0.1 } })

db.books.aggregate([
  { $group: { _id: '$year', count: { $sum: 1 } } },
  { $sort: { _id: 1 } }
])

db.books.createIndex({ title: 'text' })
db.books.find({ $text: { $search: 'moomin' } })

db.books.deleteMany({ genres: 'test' })
